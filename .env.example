# Minimal local configuration. Never commit .env or real secret values.
# Full optional settings and defaults: docs/configuration/index.md
# Production deployment: docs/deployment/tftt.md

# Local single-user login only. Production uses OIDC instead.
NUXT_SITE_TOKEN=replace-with-a-strong-private-token

# Deployment resource identifiers are ordinary build variables, not secrets.
DEPLOY_D1_DATABASE_ID=
DEPLOY_KV_NAMESPACE_ID=
# Optional: enable R2 backups and uploads by setting the bucket name.
# DEPLOY_R2_BUCKET_NAME=sink

# Optional analytics. Only the API token is secret.
# NUXT_CF_ACCOUNT_ID=
# NUXT_CF_API_TOKEN=

# Optional OIDC: configure all four together instead of the site token.
# Issuer and client ID are ordinary variables; both secrets stay server-side.
# NUXT_OIDC_ISSUER=
# NUXT_OIDC_CLIENT_ID=
# NUXT_OIDC_CLIENT_SECRET=
# NUXT_OIDC_SESSION_SECRET=
# Callback defaults to the request origin + /api/auth/callback.
# NUXT_OIDC_REDIRECT_URI=https://tftt.cc/api/auth/callback
# Optional administrator email allowlist (ordinary runtime variable).
# NUXT_SITE_ADMIN_EMAILS=

# Only add overrides when a default needs to change. Preview mode is off.
# Worker public overrides must match at build time and runtime.
